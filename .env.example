# Supabase (Project Settings > API Keys)
# Prefer the publishable key; a legacy anon key also works here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# OpenRouter or an OpenAI-compatible gateway
OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash

# Deepgram (https://console.deepgram.com/)
DEEPGRAM_API_KEY=YOUR_DEEPGRAM_KEY

# Public origin used for Supabase email confirmation redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Request logging (Node.js runtime). Set LOG_TO_FILE=false on read-only
# serverless filesystems; set LOG_CONSOLE=true to mirror lines to stdout.
LOG_TO_FILE=true
LOG_DIR=logs
LOG_LEVEL=info
LOG_MAX_FILES=14
LOG_CONSOLE=false
